PORT=5000

# Database Configuration (PostgreSQL / Neon)
DATABASE_URL="postgresql://username:password@localhost:5432/api_profile?sslmode=prefer"

# Cloudinary Configuration
CLOUDNAME=your_cloudinary_name
CLOUDKEY=your_cloudinary_key
CLOUDPASSWORD=your_cloudinary_password

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_me
JWT_EXPIRES=1d
